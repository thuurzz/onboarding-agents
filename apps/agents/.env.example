# Copie para `.env` e preencha com seus valores. Nunca versione o `.env`.

# Modelo de LLM usado pelos nós porteiro/especialista (via LiteLLM SDK).
# Troque o provider sem refatorar: ex. "openai/gpt-4o-mini", "anthropic/claude-...".
LLM_MODEL=openai/deepseek-v4-pro

# URL base do provider (OpenAI-compatible). Ex.: Ollama Cloud, LightLLM, OpenAI.
LLM_API_BASE=https://ollama.com/v1

# Chave de API do provider (obrigatória).
LLM_API_KEY=

# URL do Mock Gemud (serviço de tickets) chamado pela tool `abrir_ticket`.
MOCK_GEMUD_URL=http://localhost:8001

# Postgres do checkpointer do LangGraph (conexão local do docker-compose).
DATABASE_URL=postgresql://onboarding:onboarding@localhost:5433/onboarding
