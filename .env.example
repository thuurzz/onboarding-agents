# Copie para `.env` na raiz para o `docker compose` ler. Nunca versione o `.env`.

# Chave de API do provider de LLM (obrigatória para os agentes).
LLM_API_KEY=

# Opcionais — têm defaults no docker-compose.yml:
# LLM_MODEL=openai/deepseek-v4-pro
# LLM_API_BASE=https://ollama.com/v1
# NEXT_PUBLIC_AGENTS_API_URL=http://localhost:8002
# NEXT_PUBLIC_MOCK_GEMUD_API_URL=http://localhost:8001
